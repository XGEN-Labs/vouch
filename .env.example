# 复制为 .env 后填写，然后 npm run dev（会同时起前端 5273 和后端 8787）。
#
# 线上同一份文件放在 ECS 的 /opt/vouch/.env —— 在 releases 目录外面，
# 发新版不会被覆盖，改完 systemctl restart vouch-api 生效。
# 上线那份要改三处：JWT 密钥换随机值、VOUCH_DB_PATH 指到 /var/lib/vouch/vouch.db、
# 删掉 VOUCH_SECURE_COOKIE=0。

# 必填：JWT 签名密钥。生产由 bootstrap.sh 自动生成随机值。
VOUCH_JWT_SECRET=dev-only-change-me

# 本地是 http，必须关掉 Secure 属性，否则浏览器不回传 cookie
VOUCH_SECURE_COOKIE=0

# LLM 中转（OpenAI 兼容）
VOUCH_API_KEY=your_key_here
VOUCH_API_BASE=https://yibuapi.com
VOUCH_MODEL=claude-sonnet-5

# 联网检索：off | duckduckgo | bocha
# 阿里云国内节点连不上 DuckDuckGo，线上请用 off 或 bocha
VOUCH_SEARCH_PROVIDER=off
# VOUCH_BOCHA_KEY=

# 1 = 不需要邀请码也能注册。内测保持 0。
VOUCH_OPEN_REGISTER=0

# 限流
VOUCH_LLM_PER_MIN=12
VOUCH_LLM_PER_DAY=300
