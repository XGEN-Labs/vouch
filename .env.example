# 复制为 .env 后填写，然后 npm run dev。
#
# 当前前端默认走 Vite 里的 /api 网关（邀请码 + Gemini）。
# 阿里云账号后端存在 server/，用 npm run dev:full 同时起 8787。

# LLM 中转（OpenAI 兼容）
VOUCH_API_KEY=your_key_here
VOUCH_API_BASE=http://120.79.247.245:3000
VOUCH_MODEL=gemini-2.5-flash
VOUCH_INVITE_CODE=your_invite_here

# 账号后端（server/）用，本地 http 必须关 Secure
VOUCH_JWT_SECRET=dev-only-change-me
VOUCH_SECURE_COOKIE=0

# 联网检索：off | duckduckgo | bocha
VOUCH_SEARCH_PROVIDER=off
# VOUCH_BOCHA_KEY=

# 1 = 不需要邀请码也能注册。内测保持 0。
VOUCH_OPEN_REGISTER=0

# 限流
VOUCH_LLM_PER_MIN=12
VOUCH_LLM_PER_DAY=300
